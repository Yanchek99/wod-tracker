- content_for :header
  | Choose a new password
= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
  = f.error_notification
  = f.input :reset_password_token, as: :hidden
  = f.full_error :reset_password_token
  .form-inputs
    = render 'devise/shared/password_field', f: f, attribute: :password, label: 'New password', autocomplete: 'new-password', autofocus: true, hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length)
    = render 'devise/shared/password_field', f: f, attribute: :password_confirmation, label: 'Confirm new password', autocomplete: 'new-password'
  .form-actions.d-grid
    = f.button :submit, 'Update password', class: 'btn btn-primary'
