- content_for :header
  | Create your account
= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
  = f.error_notification
  .form-inputs
    = f.input :email, required: true, autofocus: true, input_html: { autocomplete: 'email'}
    = render 'devise/shared/password_field', f: f, attribute: :password, label: 'Password', autocomplete: 'new-password', hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length)
    = render 'devise/shared/password_field', f: f, attribute: :password_confirmation, label: 'Confirm password', autocomplete: 'new-password'
    .row.gx-3
      .col-6 = f.input :first_name, required: true
      .col-6 = f.input :last_name, required: true
    .row.gx-3
      .col-6 = f.input :weight, required: true
      .col-6 = f.input :sex, collection: User.sexes.keys.map { |sex| [sex.titleize, sex] }, required: true, prompt: 'Select sex'
  .form-actions.d-grid
    = f.button :submit, "Create account", class: 'btn btn-primary'
