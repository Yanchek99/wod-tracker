- content_for :header
  | Log in
= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-plain' }) do |f|
  .form-inputs
    = f.input :email, required: false, autofocus: resource.email.blank?
    = render 'devise/shared/password_field', f: f, attribute: :password, label: 'Password', autocomplete: 'current-password', autofocus: resource.email.present?
  .auth-options.d-flex.justify-content-between.align-items-center.mb-3
    = f.input :remember_me, as: :boolean if devise_mapping.rememberable?
    - if devise_mapping.recoverable?
      = link_to "Forgot password?", new_password_path(resource_name), class: 'small'
  .form-actions.d-grid
    = f.button :submit, "Log in", class: 'btn btn-primary'
div data-controller="passkey" data-passkey-options-url-value=options_passkey_session_path data-passkey-url-value=passkey_session_path data-passkey-cancelled-message-value="No passkey was used. If you haven't added one yet, log in with your password, then add a passkey under Edit User."
  div hidden=true data-passkey-target="supported"
    button.btn.btn-outline-secondary.w-100.mt-3 type="button" data-action="passkey#authenticate"
      span.me-2 aria-hidden="true" 🔑
      | Log in with a passkey
  p.text-danger.small.mt-2.mb-0 hidden=true role="alert" data-passkey-target="error"
