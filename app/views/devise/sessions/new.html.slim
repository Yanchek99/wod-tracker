- content_for :header
  | Log in
div data-controller="passkey" data-passkey-options-url-value=options_passkey_session_path data-passkey-url-value=passkey_session_path
  div.mb-3 hidden=true data-passkey-target="supported"
    button.btn.btn-outline-secondary.w-100 type="button" data-action="passkey#authenticate" Sign in with passkey
    .text-center.text-muted.mt-3 or use your password
  p.text-danger.small.mb-3 hidden=true role="alert" data-passkey-target="error"
= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
  .form-inputs
    = f.input :email, required: false, autofocus: true
    = f.input :password, required: false
  .row
    .col = f.input :remember_me, as: :boolean if devise_mapping.rememberable?
    .col-auto.form-actions.d-grid
      = f.button :submit, "Log in", class: 'btn btn-outline-primary'
