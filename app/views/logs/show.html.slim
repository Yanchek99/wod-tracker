.container
  .card.mt-3
    .card-body
      h5.card-title = link_to @log.workout.name, @log.workout, class: 'card-link'
      h6.card-subtitle.mb-2.text-muted #{local_time @log.created_at}
      p.card-text #{log_score_msg(@log)}
      .row
        - @log.movement_logs.each do |ml|
          .col-12
            span = measurable_message(ml)
      .mt-2.d-grid.gap-2
        = link_to 'Edit', edit_workout_log_path(@log.workout, @log), class: 'btn btn-primary'
        = link_to 'Delete', log_path(@log), data: { turbo_method: :delete }, class: 'btn btn-danger'
