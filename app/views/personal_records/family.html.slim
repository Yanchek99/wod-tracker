.container
  h1.mt-3 Personal Records
  = render 'subnav'
  - if @movement_logs.empty?
    p.text-muted No #{@family} records yet.
  - else
    .list-group.list-group-flush
      - @movement_logs.each do |pr|
        .list-group-item.py-2.d-flex.justify-content-between.align-items-center
          span.fw-semibold = pr.movement.name
          = link_to record_msg(pr), pr.log
