.container
  h1.mt-3 Personal Records
  = render 'subnav'
  - if @logs.empty?
    p.text-muted No repeated workouts yet.
  - else
    .list-group.list-group-flush
      - @logs.each do |log|
        .list-group-item.py-2.d-flex.justify-content-between.align-items-center
          span.fw-semibold = log.workout.name
          = link_to log_score_msg(log), log
