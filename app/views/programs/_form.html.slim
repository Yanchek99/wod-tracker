.form-card
  = simple_form_for program do |f|
    = f.input :name, required: false, placeholder: 'e.g. Mainsite Strength', input_html: { autofocus: true }
    .d-flex.gap-2.mt-4
      = f.button :submit, 'Create program', class: 'btn btn-primary'
      = link_to 'Cancel', programs_path, class: 'btn btn-outline-secondary'
