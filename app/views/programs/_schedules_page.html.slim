/ One page of a program's workouts, followed by a lazy frame that loads the next page as you scroll (like Workouts and History).
= turbo_frame_tag "program_schedules_page_#{schedules.current_page}" do
  - days.each_with_index do |(date, day_schedules), index|
    - unless index.zero? && date == previous_day
      .program-date = date.strftime('%a, %b %-d')
    - day_schedules.each do |schedule|
      article.schedule-card.schedule-card--solo
        = render 'schedules/workout_card', schedule: schedule, show_program: false, log_button: role.present?, log_inside: true
  - if schedules.next_page
    = turbo_frame_tag "program_schedules_page_#{schedules.next_page}", loading: :lazy, src: program_path(program, page: schedules.next_page) do
      .d-flex.justify-content-center.my-3
        .spinner-border.text-primary role="status"
          span.visually-hidden Loading…
