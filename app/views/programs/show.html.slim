- content_for :title, 'Programs'
- content_for :page_header do
  .page-header.program-header
    h1.program-title = @program.name
    .program-facts #{pluralize(@workouts, 'workout')} · #{pluralize(@followers, 'follower')}
    = role_pill(@role)
    .program-header-control
      = render 'programs/control', program: @program, role: @role, workouts: @workouts, followers: @followers
      - if can?(:destroy, @program) && @role != 'owner'
        = button_to program_path(@program), method: :delete, class: 'btn btn-outline-danger program-control', form: { data: { turbo_confirm: delete_confirm_message(@program, workouts: @workouts, followers: @followers) } } do
          | Delete
- if can? :create, Schedule.new(program: @program)
  = link_to new_program_schedule_path(@program), class: 'schedule-workout-panel' do
    = icon(:plus)
    span Schedule workout
- if @schedules.empty?
  .empty-state No workouts posted yet
- else
  - @schedule_days.each do |date, schedules|
    .program-date = date.strftime('%a, %b %-d')
    - schedules.each do |schedule|
      article.schedule-card.schedule-card--solo
        = render 'schedules/workout_card', schedule: schedule, show_program: false, log_button: @role.present?
  = paginate @schedules
