h4 Intended stimulus backfill
p
  | Scrape past CrossFit.com days, extract their Stimulus and Strategy text, and refresh the
  |  calculated stimulus for workouts without one. "Run all" chains the steps.
- if @counts
  .alert.alert-info
    strong Dry run:
    ul.mb-0
      - @counts.each do |line|
        li = line
= form_tag url_for(action: @action.action_name, model_name: @abstract_model.to_param), method: :post do
  .mb-3
    = label_tag :step, 'Step', class: 'form-label'
    = select_tag :step, options_for_select(StimulusBackfillJob::STEPS.map { |step| [step.humanize, step] }, @backfill.step), class: 'form-select'
  .row.mb-3
    .col
      = label_tag :start_date, 'Scrape from', class: 'form-label'
      = date_field_tag :start_date, @backfill.start_date, class: 'form-control'
    .col
      = label_tag :end_date, 'Scrape to', class: 'form-label'
      = date_field_tag :end_date, @backfill.end_date || Date.current, class: 'form-control'
  .form-check.mb-2
    = check_box_tag :force, '1', @backfill.force?, class: 'form-check-input'
    = label_tag :force, 'Re-extract workouts already extracted', class: 'form-check-label'
  .form-check.mb-3
    = check_box_tag :dry_run, '1', @backfill.dry_run?, class: 'form-check-input'
    = label_tag :dry_run, 'Dry run (show counts, queue nothing)', class: 'form-check-label'
  .form-actions
    button.btn.btn-primary type="submit" data-disable-with="Working…"
      i.fas.fa-check
      |  Run
