- content_for :title, 'Schedule'
= render layout: 'shared/page_header', locals: { title: 'Schedule' } do
  - unless @schedules.empty?
    .schedule-stepper
      = day_step_button link_to_next_page(@dates, icon(:chevron_left), class: 'btn btn-outline-secondary btn-icon', 'aria-label': 'Previous day'), :chevron_left, 'Previous day'
      .schedule-date data-controller="schedule-date-picker" data-schedule-date-picker-date-value=@calendar_date.iso8601 data-schedule-date-picker-scheduled-value=@scheduled_dates.to_json
        h3.schedule-date-picker-trigger data-toggle=true
          = @calendar_date.strftime('%A %B %e, %Y')
        input type="hidden" data-input=true
      - if @today
        span.chip.chip-today Today
      = day_step_button link_to_prev_page(@dates, icon(:chevron_right), class: 'btn btn-outline-secondary btn-icon', 'aria-label': 'Next day'), :chevron_right, 'Next day'
- if @schedules.empty?
  .empty-state No schedules
- else
  - @schedules.each_with_index do |schedule, index|
    - workout = schedule.workout
    - history = @workout_histories[workout.id]
    article.schedule-card
      .schedule-primary
        .schedule-main
          .schedule-program = link_to schedule.program.name, schedule.program
          h2.schedule-workout-name = workout.name
          .chips
            - workout_chips(workout).each do |chip|
              span.chip = chip
          p.schedule-objective = workout_objective workout
          ul.list-unstyled.schedule-exercises
            = render partial: 'exercises/exercises', locals: { workout: workout }
          = render partial: 'workouts/notes', locals: { workout: workout }
          = link_to 'Log workout', new_workout_log_path(workout), class: 'btn btn-primary schedule-log d-md-none'
        = link_to new_workout_log_path(workout), class: 'btn btn-primary schedule-log-desktop d-none d-md-flex align-items-center justify-content-center' do
          = icon(:plus, class: 'me-1')
          | Log workout
      - if history || index.zero?
        .schedule-side
          - if history
            aside.workout-history
              .panel-label Your history with #{workout.name}
              .stat
                span.text-muted Last result
                b #{logged_result_msg(history.last_log)} · #{history.last_log.created_at.strftime('%b %-d')}
              - if history.best_log
                .stat
                  span.text-muted Best
                  b
                    | #{logged_result_msg(history.best_log)} 
                    span.chip.chip-pr PR
              .stat
                span.text-muted Times logged
                b = history.count
          - if index.zero?
            aside.week-summary
              .panel-label This week
              .stat
                span.text-muted Workouts logged
                b #{@week.logged_count} of #{@week.scheduled_count}
              .stat
                span.text-muted New PRs
                b = @week.new_pr_count
