- content_for :wide, 'true'
.container
  h1 New Workout
  - schedule_program_id = params[:schedule_program_id].presence
  = form_with url: extract_workouts_path, method: :post, local: true, data: { turbo: false } do |form|
    = hidden_field_tag :schedule_program_id, schedule_program_id if schedule_program_id
    .mb-3
      = form.label :wod_text, 'Paste workout text', class: 'form-label'
      = form.text_area :wod_text, value: @wod_text, class: 'form-control', rows: 12

    = form.submit 'Extract Workout', class: 'btn btn-primary'
  = link_to 'Enter manually instead', new_workout_path(schedule_program_id: schedule_program_id), class: 'btn btn-outline-secondary mt-2'
